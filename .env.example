# Lumintik WhatsApp API — backend (Express + Socket.io)
# Copia este archivo a .env y rellena los valores. NO subas .env al repo.

# ── Servidor ──
# El código cae a 3001 y 0.0.0.0 si no se definen.
PORT=
HOST=
NODE_ENV=

# ── Base de datos (obligatoria: sin ella el proceso lanza excepción al arrancar) ──
# src/lib/db.ts. Es el mismo Postgres que usa CRM-ms, con dos esquemas: `app` y `crm`.
DATABASE_URL=

# ── JWT (OBLIGATORIA en producción: el proceso ya no arranca sin ella) ──
# Antes caía a un secreto adivinable escrito en el código.
# La usan por igual el middleware HTTP y el handshake del WebSocket.
JWT_SECRET=

# ── WebSocket: sockets sin token de sesión ──
# El handshake exige el token SIEMPRE: sin token válido el socket no se conecta,
# y sin identidad no se entra a la sala de ningún número. Por esa sala sale el QR
# de vinculación de WhatsApp, que es una credencial: quien lo escanee primero se
# queda con la línea. El front que se despliega con esta entrega ya manda el
# token (hooks/useSocket.ts y context/WhatsAppContext.tsx).
#
# Salida de emergencia CON FECHA OBLIGATORIA (YYYY-MM-DD, UTC): admite sockets
# sin token hasta el final de ese día —sin acceso a ninguna sala— y después
# vuelve a rechazar sola. Vacío = rechazar (lo correcto).
#   WS_GRACIA_SIN_TOKEN=2026-09-05
WS_GRACIA_SIN_TOKEN=

# ── URL pública del front ──
# La usan los correos que llevan un enlace de vuelta a la app: el botón de
# confirmar cuenta del correo de bienvenida y el "Ver Planes" del aviso de límite.
# Sin ella, esos correos salen SIN botón (antes apuntaban a app.botopia.online,
# un dominio muerto). También se añade sola a la lista de CORS.
APP_URL=

# ── CORS: orígenes extra, separados por coma ──
# Solo hace falta si el front NO está en un dominio *.vercel.app.
# Ej.: ALLOWED_ORIGINS=https://app.midominio.com,https://www.midominio.com
ALLOWED_ORIGINS=

# ── SMTP / nodemailer ──
# Si falta alguna de HOST/PORT/USER/PASS el servicio de correo queda DESHABILITADO
# (avisa por consola, no tumba el proceso). SMTP_USER es también el remitente.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# ── Google GenAI (respuestas automáticas del agente IA) ──
GOOGLE_GENAI_API_KEY=

# ── dLocal Go (pagos y suscripciones) ──
# Se envían como `Bearer API_KEY:API_SECRET`. El entorno lo decide NODE_ENV:
# production -> api.dlocalgo.com · cualquier otro -> api-sbx.dlocalgo.com.
API_KEY=
API_SECRET=

# ── Verificación por WhatsApp en el registro (opcional, hoy apagada) ──
# Id de la fila de app."WhatsAppNumber" cuya sesión enviaría los códigos OTP.
# Sin ella, /api/auth/verify-whatsapp y /resend-otp responden 503 explicando qué
# falta, en vez del 404 que devolvían antes.
WHATSAPP_OTP_NUMBER_ID=

# ── Puppeteer / Chromium (lo fija nixpacks.toml en Railway) ──
# Solo tócalas si despliegas fuera de Railway y Chromium está en otra ruta.
# PUPPETEER_SKIP_DOWNLOAD=true
# PUPPETEER_EXECUTABLE_PATH=/root/.nix-profile/bin/chromium

# ── Limpieza por antigüedad (src/lib/retention.ts) ──
# Se dispara sola 30 s después de arrancar y, gracias a app.maintenance_log, no
# se repite antes de 20 horas aunque el servicio se reinicie en bucle. Una vez al
# día es de sobra; para forzarla a mano: POST /api/stats/retention (admin).
# 0 o vacío = NO borrar esa tabla.
#
# Telemetría de infraestructura: una fila por request HTTP y por evento de socket.
# Es lo único que se borra por defecto, porque stats nunca mira más de 12 meses.
# TELEMETRY_RETENTION_DAYS=90
#
# Los tres de abajo nacen APAGADOS a propósito: son dato de negocio, no basura.
# crm.events   -> bitácora por contacto
# EVENTS_RETENTION_DAYS=0
# crm.conversations -> el historial de chat con el cliente
# CONVERSATIONS_RETENTION_DAYS=0
# app.ai_usage -> la prueba de cuánto costó la IA cada mes. Si algún día se
# activa, 400 días es el mínimo razonable (deja cerrar un ejercicio completo).
# AI_USAGE_RETENTION_DAYS=0
#
# RETENTION_ON_BOOT=false apaga el disparo automático del arranque.
