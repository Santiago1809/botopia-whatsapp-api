# Lumintik WhatsApp API — backend (Express + Socket.io)
# Copia este archivo a .env y rellena los valores. NO subas .env al repo.

# ── Servidor ──
# El código cae a 3001 y 0.0.0.0 si no se definen.
PORT=
HOST=
NODE_ENV=

# ── Supabase (obligatorias: sin ellas el proceso lanza excepción al arrancar) ──
# src/config/db.ts
SUPABASE_URL=
SUPABASE_KEY=

# ── JWT (obligatoria en la práctica: si falta se usa un secreto por defecto inseguro) ──
JWT_SECRET=

# ── SMTP / nodemailer ──
# Si falta alguna de HOST/PORT/USER/PASS el servicio de correo queda DESHABILITADO
# (avisa por consola, no tumba el proceso). SMTP_USER es también el remitente.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# ── Google GenAI (respuestas automáticas del agente IA) ──
GOOGLE_GENAI_API_KEY=

# ── dLocal Go (pagos y suscripciones) ──
# Se envían como `Bearer API_KEY:API_SECRET` contra api-sbx.dlocalgo.com.
API_KEY=
API_SECRET=
